#!/bin/sh
# ==============================================================================
# sb-bonk / sb-honk: Sing-Box (裸核) & Honk (eBPF) 统一内核管理与互斥切换快捷指令
# 项目地址: https://github.com/wuziwei/honk-config-template
# 特点：纯裸核原生 procd 服务管理、无第三方面板依赖、自动处理 Flow Offload、实时日志
# ==============================================================================

# 自动自举与快捷软链
self_path=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
if [ "$self_path" != "/usr/bin/sb-bonk" ] && [ -d "/usr/bin" ]; then
    cp -f "$self_path" /usr/bin/sb-bonk 2>/dev/null && chmod +x /usr/bin/sb-bonk 2>/dev/null
    ln -sf /usr/bin/sb-bonk /usr/bin/sb-honk 2>/dev/null
    ln -sf /usr/bin/sb-bonk /usr/bin/sb 2>/dev/null
fi

# 颜色控制
ESC=$(printf '\033')
RED="${ESC}[0;31m"
GREEN="${ESC}[0;32m"
YELLOW="${ESC}[1;33m"
BLUE="${ESC}[0;34m"
PURPLE="${ESC}[0;35m"
CYAN="${ESC}[0;36m"
BOLD="${ESC}[1m"
NC="${ESC}[0m"

# 核心状态检测函数
get_status() {
    # 检测 sing-box (纯裸核)
    sb_pid=$(pgrep -f "sing-box run" 2>/dev/null | head -n 1)
    if [ -n "$sb_pid" ]; then
        SB_STATE="${GREEN}● 运行中 (PID: $sb_pid)${NC}"
        SB_ACTIVE=1
    else
        SB_STATE="${RED}○ 已停止${NC}"
        SB_ACTIVE=0
    fi

    # 检测 honk
    honk_pid=$(pgrep -f "/usr/bin/honk" 2>/dev/null | head -n 1)
    if [ -n "$honk_pid" ]; then
        HONK_STATE="${GREEN}● 运行中 (PID: $honk_pid)${NC}"
        HONK_ACTIVE=1
    else
        HONK_STATE="${RED}○ 已停止${NC}"
        HONK_ACTIVE=0
    fi

    # 检测防火墙流分流
    flow_offload=$(uci get firewall.@defaults[0].flow_offloading 2>/dev/null || echo "0")
    flow_offload_hw=$(uci get firewall.@defaults[0].flow_offloading_hw 2>/dev/null || echo "0")
    if [ "$flow_offload" = "1" ] && [ "$flow_offload_hw" = "1" ]; then
        FLOW_STATE="${GREEN}开启 (硬件 PPE 芯片加速 ON)${NC}"
    elif [ "$flow_offload" = "1" ]; then
        FLOW_STATE="${YELLOW}开启 (软件 Flow Offload ON)${NC}"
    else
        FLOW_STATE="${YELLOW}关闭 (Flow Offload OFF)${NC}"
    fi

    # 检测 DNS 劫持与防泄露模式
    dns_server=$(uci -q get dhcp.@dnsmasq[0].server || echo "")
    dns_noresolv=$(uci -q get dhcp.@dnsmasq[0].noresolv || echo "0")
    if [ "$dns_noresolv" = "1" ] && echo "$dns_server" | grep -q "5353"; then
        DNS_STATE="${GREEN}Honk DoH (127.0.0.1#5353 零泄露模式)${NC}"
    else
        DNS_STATE="${YELLOW}系统默认 (WAN 上游 / Sing-Box TUN 接管)${NC}"
    fi
}

# 进程平滑退出与超时硬杀
graceful_stop_proc() {
    local pattern="$1"
    local kill_name="$2"
    local timeout="${3:-5}"
    local count=0
    while [ "$count" -lt "$timeout" ]; do
        if ! pgrep -f "$pattern" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    killall -9 "$kill_name" 2>/dev/null || true
}

# 彻底清理 Sing-Box 残留的 nftables 规则、TUN 虚拟网卡与策略路由表
cleanup_singbox_leftovers() {
    nft delete table inet sing-box 2>/dev/null || true
    ip link del tun0 2>/dev/null || true
    for fam in -4 -6; do
        for pref in $(ip $fam rule show 2>/dev/null | awk -F: '/lookup 2022|0x2023|0x2024/ {gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1}'); do
            ip $fam rule del pref "$pref" 2>/dev/null || true
        done
        ip $fam rule del pref 9002 2>/dev/null || true
        ip $fam route flush table 2022 2>/dev/null || true
    done
}

# 清理 Honk 残留的 nftables 规则、pinned eBPF maps 与网卡，并恢复常规 PPE 卸载
cleanup_honk_leftovers() {
    nft delete table inet honk_nfqueue 2>/dev/null || true
    rm -f /sys/fs/bpf/* 2>/dev/null || true
    ip link del dae0 2>/dev/null || true
    /usr/libexec/honk-ppe-gate.sh disable 2>/dev/null || true
}

# 多核 RPS/RFS 软中断分流调优 (突破单核纯软转发吞吐上限)
apply_rps_tuning() {
    local mask="${1:-d}"
    sysctl -w net.core.rps_sock_flow_entries=32768 >/dev/null 2>&1
    for dev in pon0 eth0 lan1 lan2 lan3 lan4 pppoe-wan br-lan phy0-ap0 phy1-ap0 dae0; do
        if [ -d "/sys/class/net/$dev/queues" ]; then
            for q in /sys/class/net/$dev/queues/rx-*; do
                [ -f "$q/rps_cpus" ] && echo "$mask" > "$q/rps_cpus" 2>/dev/null
                [ -f "$q/rps_flow_cnt" ] && echo 4096 > "$q/rps_flow_cnt" 2>/dev/null
            done
        fi
    done
    if [ -f /sys/devices/system/cpu/cpufreq/ondemand/powersave_bias ]; then
        echo 0 > /sys/devices/system/cpu/cpufreq/ondemand/powersave_bias 2>/dev/null
    fi
    if [ -w /sys/kernel/debug/ppe/bind_rate ]; then
        echo "30 30" > /sys/kernel/debug/ppe/bind_rate 2>/dev/null
    fi
}

# 1. 切换到 Honk
switch_to_honk() {
    echo ""
    echo "${CYAN}${BOLD}[1/5] 检查并停止 Sing-Box (裸核)...${NC}"
    /etc/init.d/sing-box stop 2>/dev/null
    graceful_stop_proc "sing-box run" "sing-box" 5
    cleanup_singbox_leftovers
    echo "  ${GREEN}✓ Sing-Box 已停止并清理残留规则${NC}"

    echo "${CYAN}${BOLD}[2/5] 调整防火墙 (启用硬件 PPE 芯片加速与流分流)...${NC}"
    uci set firewall.@defaults[0].flow_offloading='1' 2>/dev/null
    uci set firewall.@defaults[0].flow_offloading_hw='1' 2>/dev/null
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null || /etc/init.d/firewall restart 2>/dev/null
    apply_rps_tuning "d"
    echo "  ${GREEN}✓ 硬件 PPE 芯片流分流加速已启用，全队列多核优化生效${NC}"

    echo "${CYAN}${BOLD}[3/5] 联动 Dnsmasq (重定向至 Honk 127.0.0.1#5353 根除 DNS 泄露与抢答投毒)...${NC}"
    uci set dhcp.@dnsmasq[0].noresolv='1' 2>/dev/null
    uci -q delete dhcp.@dnsmasq[0].server 2>/dev/null
    uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#5353' 2>/dev/null
    uci commit dhcp 2>/dev/null
    /etc/init.d/dnsmasq restart 2>/dev/null
    echo "  ${GREEN}✓ Dnsmasq 上游已锁定为 127.0.0.1#5353 (零泄露保护生效)${NC}"

    echo "${CYAN}${BOLD}[4/5] 检查 eBPF 虚拟文件系统 (bpffs)...${NC}"
    if ! mount | grep -q "/sys/fs/bpf"; then
        mkdir -p /sys/fs/bpf
        mount -t bpf bpffs /sys/fs/bpf 2>/dev/null || true
    fi
    cleanup_honk_leftovers

    echo "${CYAN}${BOLD}[5/5] 启动 Honk (eBPF 内核线速分流)...${NC}"
    uci set honk.config.store='file' 2>/dev/null
    uci commit honk 2>/dev/null

    if [ -x "/etc/init.d/honk" ]; then
        /etc/init.d/honk restart 2>/dev/null
    else
        ( trap "" HUP; honk-core --config /etc/honk/config.dae --log-file /var/log/honk.log >/dev/null 2>&1 ) </dev/null &
    fi
    /usr/libexec/honk-ppe-gate.sh enable 2>/dev/null || true

    sleep 1
    honk_pid=$(pgrep -f "honk" 2>/dev/null | head -n 1)
    if [ -n "$honk_pid" ]; then
        echo "  ${GREEN}✓ Honk 启动成功 (PID: $honk_pid)${NC}"
        echo ""
        echo "${GREEN}${BOLD}🎉 已无缝切换至 Honk 模式！(硬件 PPE 满血加速 + eBPF 线速分流 + DNS 零泄露)${NC}"
    else
        echo "  ${RED}✗ Honk 启动失败，请检查 /var/log/honk.log${NC}"
    fi
}

# 2. 切换到 Sing-Box
switch_to_singbox() {
    echo ""
    echo "${CYAN}${BOLD}[1/4] 停止 Honk (释放 eBPF 挂载点与网络设备)...${NC}"
    /etc/init.d/honk stop 2>/dev/null
    graceful_stop_proc "honk" "honk" 5
    cleanup_honk_leftovers
    echo "  ${GREEN}✓ Honk 已安全停止${NC}"

    echo "${CYAN}${BOLD}[2/4] 还原 Dnsmasq 默认配置...${NC}"
    uci set dhcp.@dnsmasq[0].noresolv='0' 2>/dev/null
    uci -q delete dhcp.@dnsmasq[0].server 2>/dev/null
    uci commit dhcp 2>/dev/null
    /etc/init.d/dnsmasq restart 2>/dev/null
    echo "  ${GREEN}✓ Dnsmasq 已还原系统解析${NC}"

    echo "${CYAN}${BOLD}[3/4] 调整防火墙 (恢复常规硬件加速)...${NC}"
    uci set firewall.@defaults[0].flow_offloading='1' 2>/dev/null
    uci set firewall.@defaults[0].flow_offloading_hw='1' 2>/dev/null
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null || /etc/init.d/firewall restart 2>/dev/null
    /usr/libexec/honk-ppe-gate.sh disable 2>/dev/null || true
    echo "  ${GREEN}✓ 防火墙硬件 PPE 芯片加速已就绪${NC}"

    echo "${CYAN}${BOLD}[4/4] 启动 Sing-Box (裸核)...${NC}"
    cleanup_singbox_leftovers
    if [ -x "/etc/init.d/sing-box" ]; then
        /etc/init.d/sing-box restart 2>/dev/null
    else
        ( trap "" HUP; /usr/bin/sing-box run -c /etc/sing-box/config.json >/var/log/sing-box.log 2>&1 ) </dev/null &
    fi

    sleep 1
    sb_pid=$(pgrep -f "sing-box run" 2>/dev/null | head -n 1)
    if [ -n "$sb_pid" ]; then
        echo "  ${GREEN}✓ Sing-Box 启动成功 (PID: $sb_pid)${NC}"
        echo ""
        echo "${GREEN}${BOLD}🎉 已无缝切换至 Sing-Box (裸核模式)！${NC}"
    else
        echo "  ${RED}✗ Sing-Box 启动失败，请检查配置文件${NC}"
    fi
}

# 3. 停止所有服务
stop_all() {
    echo ""
    echo "${YELLOW}[1/3] 正在停止 Sing-Box...${NC}"
    /etc/init.d/sing-box stop 2>/dev/null
    graceful_stop_proc "sing-box run" "sing-box" 5
    cleanup_singbox_leftovers

    echo "${YELLOW}[2/3] 正在停止 Honk...${NC}"
    /etc/init.d/honk stop 2>/dev/null
    graceful_stop_proc "honk" "honk" 5
    cleanup_honk_leftovers

    echo "${YELLOW}[3/3] 还原 Dnsmasq 与防火墙配置...${NC}"
    uci set dhcp.@dnsmasq[0].noresolv='0' 2>/dev/null
    uci -q delete dhcp.@dnsmasq[0].server 2>/dev/null
    uci commit dhcp 2>/dev/null
    /etc/init.d/dnsmasq restart 2>/dev/null

    uci set firewall.@defaults[0].flow_offloading='1' 2>/dev/null
    uci set firewall.@defaults[0].flow_offloading_hw='1' 2>/dev/null
    uci commit firewall 2>/dev/null
    /etc/init.d/firewall reload 2>/dev/null || /etc/init.d/firewall restart 2>/dev/null
    /usr/libexec/honk-ppe-gate.sh disable 2>/dev/null || true

    echo "${GREEN}✓ 所有代理核心已安全停止，网络已直连直通${NC}"
}

# 主菜单与命令分发
case "$1" in
    honk|1)
        switch_to_honk
        ;;
    sb|singbox|2)
        switch_to_singbox
        ;;
    stop|3)
        stop_all
        ;;
    status|4)
        get_status
        echo "=========================================="
        echo " Sing-Box 状态: $SB_STATE"
        echo " Honk 状态:     $HONK_STATE"
        echo " 流分流加速:    $FLOW_STATE"
        echo " DNS 劫持防护:  $DNS_STATE"
        echo "=========================================="
        ;;
    log|5)
        tail -f /var/log/honk.log 2>/dev/null || logread -f
        ;;
    *)
        get_status
        echo "=========================================="
        echo " Ponwrt 代理核心管理控制器"
        echo "=========================================="
        echo " 1) 切换到 Honk (开启 PPE 满血加速)"
        echo " 2) 切换到 Sing-Box (裸核模式)"
        echo " 3) 停止所有代理服务 (完全直连)"
        echo " 4) 查看服务状态"
        echo " 5) 实时查看日志"
        echo "=========================================="
        read -p " 请输入操作编号 [1-5]: " choice
        case "$choice" in
            1) switch_to_honk ;;
            2) switch_to_singbox ;;
            3) stop_all ;;
            4) get_status ;;
            5) tail -f /var/log/honk.log 2>/dev/null || logread -f ;;
            *) echo "无效选项" ;;
        esac
        ;;
esac
